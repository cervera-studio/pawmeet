---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n';
import { getAlternatePath } from '../i18n/routes';
import { getCanonicalPath } from '../i18n/routes';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  locale?: Locale;
  isHomepage?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  locale = 'it',
  isHomepage = false,
} = Astro.props;

const strings = t(locale);
const defaultDescription = locale === 'it'
  ? 'PawMeet trova compagni di passeggiata compatibili per il tuo cane in base a taglia, energia e temperamento. Unisciti a 1.200+ proprietari in Italia.'
  : 'PawMeet matches your dog with compatible walking companions by size, energy and temperament. Join 1,200+ dog owners already waiting.';

const resolvedDescription = description ?? defaultDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const itPath = getAlternatePath(currentPath, 'it');
const enPath = getAlternatePath(currentPath, 'en');
const itUrl = new URL(itPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);

const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={locale} class="no-transition">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#065F46" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={itUrl} />

    {/* FOUC prevention — runs before any paint */}
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
          if (stored === 'dark') {
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#111111');
          }
        }
        // Remove no-transition class after first paint
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            document.documentElement.classList.remove('no-transition');
          });
        });
      })();
    </script>

    <title>{title} | PawMeet</title>
    <meta name="description" content={resolvedDescription} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | PawMeet`} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content="PawMeet" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pawmeetapp" />
    <meta name="twitter:title" content={`${title} | PawMeet`} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PawMeet",
      "url": "https://pawmeet.io",
      "logo": "https://pawmeet.io/favicon.svg",
      "sameAs": [],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@cervera.studio",
        "contactType": "customer support",
        "availableLanguage": ["Italian", "English"]
      }
    })} />

    <!-- Structured Data: WebSite with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PawMeet",
      "url": "https://pawmeet.io",
      "inLanguage": locale === 'it' ? "it-IT" : "en-US",
      "description": resolvedDescription
    })} />

    <!-- Structured Data: MobileApplication (homepage only) -->
    {isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        "name": "PawMeet",
        "operatingSystem": "iOS, Android",
        "applicationCategory": "SocialNetworkingApplication",
        "description": locale === 'it'
          ? "App per trovare compagni di passeggiata compatibili per il tuo cane. Match intelligente per taglia, energia e temperamento."
          : "App to find compatible walking companions for your dog. Smart matching by size, energy, and temperament.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
          "availability": "https://schema.org/PreOrder"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5",
          "ratingCount": "1200",
          "reviewCount": "1200"
        },
        "url": "https://pawmeet.io",
        "inLanguage": locale === 'it' ? "it-IT" : "en-US"
      })} />
    )}
  </head>
  <body class="min-h-screen flex flex-col font-sans text-neutral-900 bg-surface grain">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg">
      {strings.nav.skipToContent}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
