{
  "name": "pawmeet",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@pawmeet/typescript-config": "workspace:*",
    "@pawmeet/vitest-config": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "lefthook": "^2.1.0",
    "turbo": "^2.8.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22"
  }
}
