---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n';
import HowItWorksClient from './HowItWorksClient';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const strings = t(locale);
---

<HowItWorksClient client:visible strings={strings.steps} />
