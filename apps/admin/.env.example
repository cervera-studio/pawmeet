# ──────────────────────────────────────────────
# Admin Backoffice (Next.js) Environment Variables
# Copy to .env.local and fill in your values
# ──────────────────────────────────────────────

# API base URL for tRPC client (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public URL of this admin app (used for CSRF origin validation)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App version injected at build time (e.g. git SHA or semver tag)
APP_VERSION=
