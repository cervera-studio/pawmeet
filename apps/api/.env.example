# ──────────────────────────────────────────────
# API Server Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database (Neon PostgreSQL + PostGIS) ──────
DATABASE_URL=postgresql://user:password@localhost:5432/pawmeet

# ── Redis: Upstash (REST API for rate limiting, caching) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Redis: Standard (BullMQ job queues) ───────
# Used by notification, email, and photo moderation workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cloudflare R2 (S3-compatible object storage) ──
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pawmeet
R2_PUBLIC_URL=https://cdn.pawmeet.io

# ── Authentication (JWT via jose) ─────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-a-different-string
JWT_ADMIN_SECRET=change-me-in-production-use-a-separate-admin-secret

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=PawMeet <noreply@pawmeet.io>
APP_URL=https://pawmeet.io

# ── Push Notifications (Expo) ─────────────────
# Optional: only needed if sending push via Expo's HTTP/2 API with auth
EXPO_ACCESS_TOKEN=

# ── Sentry (Error Tracking) ─────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Release Version ─────────────────────────
# Set automatically in CI from git SHA. Used by Sentry release tracking.
APP_VERSION=

# ── PostHog (Product Analytics) ─────────────
# PostHog Cloud EU free tier. Leave empty to disable forwarding.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Personal API key + project ID for GDPR person deletion (optional)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Analytics Pseudonymization ──────────────
# HMAC-SHA256 salt for pseudonymizing userIds sent to third parties
ANALYTICS_HASH_SALT=change-me-in-production-use-a-random-string

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development
