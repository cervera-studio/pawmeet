# ──────────────────────────────────────────────
# API Server Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database (Neon PostgreSQL + PostGIS) ──────
DATABASE_URL=postgresql://user:password@localhost:5432/dogwalk

# ── Redis: Upstash (REST API for rate limiting, caching) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Redis: Standard (BullMQ job queues) ───────
# Used by notification, email, and photo moderation workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cloudflare R2 (S3-compatible object storage) ──
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dogwalk
R2_PUBLIC_URL=https://cdn.dogwalk.app

# ── Authentication (JWT via jose) ─────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-a-different-string
JWT_ADMIN_SECRET=change-me-in-production-use-a-separate-admin-secret

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=DogWalk <noreply@dogwalk.app>
APP_URL=https://dogwalk.app

# ── Push Notifications (Expo) ─────────────────
# Optional: only needed if sending push via Expo's HTTP/2 API with auth
EXPO_ACCESS_TOKEN=

# ── Sentry (Error Tracking) ─────────────────
SENTRY_DSN=

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development
