# Non-sensitive variables — set these in Terraform Cloud workspace as Terraform Variables.
# Sensitive variables (api_secrets, admin_secrets) must be marked as "Sensitive" in TF Cloud.
#
# For local overrides during development, copy to terraform.tfvars (gitignored).

subscription_id = "your-azure-subscription-id"
project         = "pawmeet"
environment     = "prod"
location        = "westeurope"
min_replicas    = 2
max_replicas    = 5

# api_secrets and admin_secrets → set as HCL-type sensitive variables in TF Cloud.
# Example HCL value for api_secrets:
# {
#   DATABASE_URL              = "postgresql://..."
#   UPSTASH_REDIS_REST_URL    = "https://..."
#   UPSTASH_REDIS_REST_TOKEN  = "..."
#   REDIS_HOST                = "..."
#   REDIS_PORT                = "6379"
#   REDIS_PASSWORD            = "..."
#   REDIS_TLS                 = "true"
#   R2_ENDPOINT               = "https://..."
#   R2_ACCESS_KEY_ID          = "..."
#   R2_SECRET_ACCESS_KEY      = "..."
#   R2_BUCKET                 = "pawmeet"
#   R2_PUBLIC_URL             = "https://cdn.pawmeet.io"
#   JWT_SECRET                = "..."
#   JWT_REFRESH_SECRET        = "..."
#   JWT_ADMIN_SECRET          = "..."
#   RESEND_API_KEY            = "..."
#   FROM_EMAIL                = "PawMeet <noreply@pawmeet.io>"
#   APP_URL                   = "https://pawmeet.io"
#   EXPO_ACCESS_TOKEN         = "..."
#   SENTRY_DSN                = "..."
#   POSTHOG_API_KEY           = "..."
#   POSTHOG_HOST              = "https://eu.i.posthog.com"
#   POSTHOG_PROJECT_ID        = "..."
#   POSTHOG_PERSONAL_API_KEY  = "..."
#   ANALYTICS_HASH_SALT       = "..."
#   MESSAGE_ENCRYPTION_KEY    = "..."
#   STATSIG_SERVER_SECRET     = "..."
#   GOOGLE_CLIENT_ID          = "..."
#   PLAY_INTEGRITY_CLIENT_EMAIL = "..."
#   PLAY_INTEGRITY_PRIVATE_KEY  = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# }
