{
  "expo": {
    "name": "PawMeet",
    "slug": "pawmeet",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "pawmeet",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.pawmeet.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": ["webcredentials:pawmeet.io"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Per mostrarti cani nelle vicinanze",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Per aggiornare la tua posizione",
        "NSCameraUsageDescription": "Per scattare foto del tuo cane",
        "NSPhotoLibraryUsageDescription": "Per caricare foto del tuo cane",
        "NSHealthShareUsageDescription": "PawMeet utilizza i dati di Apple Salute per sincronizzare passi, distanza e attività con il tuo profilo.",
        "NSFaceIDUsageDescription": "Per proteggere l'accesso alla tua app PawMeet",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#065F46"
      },
      "package": "io.pawmeet.mobile",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "organization": "cervera-studio",
          "project": "pawmeet-mobile"
        }
      ],
      "./plugins/with-certificate-pinning",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "react-native-health-connect",
        {
          "isSdkExtensionPatched": true
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "979c0a63-948a-4c9c-a003-0b0f09a55bf9"
      }
    },
    "owner": "cerverastudio"
  }
}
