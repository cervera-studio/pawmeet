---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import HowItWorks from '../HowItWorks.astro';
import Features from '../Features.astro';
import DownloadCTA from '../DownloadCTA.astro';
import WaitlistForm from '../WaitlistForm.astro';
import { t } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<BaseLayout title={strings.meta.homeTitle} locale={locale} isHomepage={true}>
  <Hero locale={locale} />
  <HowItWorks locale={locale} />
  <Features locale={locale} />
  <WaitlistForm locale={locale} />
  <DownloadCTA locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": strings.faq.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer,
      },
    })),
  })} />
</BaseLayout>
