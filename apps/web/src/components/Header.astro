---
import type { Locale } from '../i18n/locales';
import { t, getLocalizedPath, LOCALE_CODES } from '../i18n';
import { getNavLinks } from '../data/navigation';
import { getAlternatePath } from '../i18n/routes';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const strings = t(locale);
const navLinks = getNavLinks(locale);
const waitlistHref = getLocalizedPath('/waitlist', locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const otherLocales = LOCALE_CODES.filter((l) => l !== locale);
const localeLinks = otherLocales.map((l) => ({
  code: l,
  label: t(l).nav.langLabel,
  href: getAlternatePath(currentPath, l),
}));
---

<header class="fixed top-0 left-0 right-0 z-50">
  {/* Glass bar */}
  <nav class="mx-auto max-w-7xl px-6 sm:px-8">
    <div class="flex items-center justify-between h-16 border-b border-neutral-200/60">
      {/* Logo — wordmark only, confident */}
      <a href={getLocalizedPath('/', locale)} class="text-[17px] font-semibold tracking-[-0.01em] text-neutral-900 hover:opacity-70 transition-opacity">
        PawMeet
      </a>

      {/* Center nav — desktop */}
      <ul class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[13px] font-medium text-neutral-500 hover:text-neutral-900 transition-colors duration-200"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Right group — utilities + CTA */}
      <div class="flex items-center gap-3">
        {/* Language switcher — dropdown */}
        <div class="hidden sm:flex items-center relative" id="lang-switcher">
          <button
            class="flex items-center gap-1 text-[12px] font-medium text-neutral-500 hover:text-neutral-900 transition-colors tracking-wide uppercase"
            aria-label={strings.nav.changeLanguage}
            aria-expanded="false"
            id="lang-toggle"
          >
            {strings.nav.langLabel}
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute top-full right-0 mt-2 py-1 bg-surface border border-neutral-200 rounded-lg shadow-lg min-w-[80px]">
            {localeLinks.map((link) => (
              <a
                href={link.href}
                class="block px-3 py-1.5 text-[12px] font-medium text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 transition-colors tracking-wide uppercase"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        {/* Divider */}
        <span class="hidden sm:block w-[1px] h-4 bg-neutral-200" aria-hidden="true"></span>

        {/* Theme toggle — sun/moon */}
        <button
          id="theme-toggle"
          class="p-2 text-neutral-500 hover:text-neutral-900 transition-colors rounded-lg"
          aria-label={strings.nav.changeTheme}
        >
          {/* Sun — shown in dark mode */}
          <svg id="theme-sun" class="w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          {/* Moon — shown in light mode */}
          <svg id="theme-moon" class="w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        {/* CTA — ghost, steps back */}
        <a
          href={waitlistHref}
          class="hidden sm:inline-flex items-center px-5 py-1.5 rounded-full text-[13px] font-medium text-neutral-900 border border-neutral-200 hover:bg-neutral-900 hover:text-surface hover:border-neutral-900 transition-all duration-200"
        >
          {strings.nav.waitlist}
        </a>

        {/* Mobile menu button */}
        <button
          class="md:hidden p-2 text-neutral-500"
          aria-label={strings.nav.openMenu}
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-btn"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  {/* Mobile menu */}
  <div id="mobile-menu" class="hidden md:hidden bg-surface-glass backdrop-blur-xl border-b border-neutral-200/60">
    <div class="max-w-7xl mx-auto px-6 py-6 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-2.5 text-[15px] font-medium text-neutral-700 hover:text-neutral-900 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 mt-4 border-t border-neutral-200/60 flex items-center justify-between">
        <a
          href={waitlistHref}
          class="inline-flex items-center px-5 py-2 rounded-full text-[13px] font-medium text-neutral-900 border border-neutral-200 hover:bg-neutral-900 hover:text-surface hover:border-neutral-900 transition-all duration-200"
        >
          {strings.nav.waitlist}
        </a>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            {localeLinks.map((link) => (
              <a
                href={link.href}
                class="text-[12px] font-medium text-neutral-500 hover:text-neutral-900 tracking-wide uppercase transition-colors"
              >
                {link.label}
              </a>
            ))}
          </div>
          <button
            id="theme-toggle-mobile"
            class="p-2 text-neutral-500 rounded-lg"
            aria-label={strings.nav.changeTheme}
          >
            <svg class="theme-sun w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            <svg class="theme-moon w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

{/* Header background — blurs on scroll */}
<style>
  header {
    background: var(--color-surface-glass);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }
</style>

<script>
  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });

  // Language dropdown
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');
  langToggle?.addEventListener('click', () => {
    const isOpen = langMenu?.classList.toggle('hidden') === false;
    langToggle.setAttribute('aria-expanded', String(isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!document.getElementById('lang-switcher')?.contains(e.target as Node)) {
      langMenu?.classList.add('hidden');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Theme toggle
  function getEffectiveTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    updateIcons(theme);
    // Update theme-color meta
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#111111' : '#065F46');
  }

  function updateIcons(theme: 'light' | 'dark') {
    // Desktop icons
    document.getElementById('theme-sun')?.classList.toggle('hidden', theme !== 'dark');
    document.getElementById('theme-moon')?.classList.toggle('hidden', theme !== 'light');
    // Mobile icons
    document.querySelectorAll('.theme-sun').forEach(el => el.classList.toggle('hidden', theme !== 'dark'));
    document.querySelectorAll('.theme-moon').forEach(el => el.classList.toggle('hidden', theme !== 'light'));
  }

  // Initialize
  updateIcons(getEffectiveTheme());

  // Toggle handlers
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    applyTheme(getEffectiveTheme() === 'dark' ? 'light' : 'dark');
  });
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', () => {
    applyTheme(getEffectiveTheme() === 'dark' ? 'light' : 'dark');
  });

  // System preference change
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      updateIcons(e.matches ? 'dark' : 'light');
    }
  });
</script>
