{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "npx tsx scripts/validate-cert-pins.ts"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "npx tsx scripts/validate-cert-pins.ts"
    }
  }
}
