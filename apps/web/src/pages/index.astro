---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { t } from '../i18n';

const strings = t('it');
---

<BaseLayout title={strings.meta.homeTitle} locale="it">
  <Hero locale="it" />
  <HowItWorks locale="it" />
  <Features locale="it" />
  <WaitlistForm locale="it" />
  <DownloadCTA locale="it" />
</BaseLayout>
