---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getSizeLabel, getEnergyLabel, getBehaviorLabel, getGenderLabel } from '../../lib/dog-labels';
import type { PublicDogProfile } from '@pawmeet/types';

const locale = 'it';
const strings = t(locale);
const { id } = Astro.params;

const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
let dog: PublicDogProfile | null = null;

try {
  const res = await fetch(`${apiBase}/trpc/dogs.getPublicProfile?input=${encodeURIComponent(JSON.stringify({ id }))}`);
  if (res.ok) {
    const json = await res.json();
    dog = json.result?.data ?? null;
  }
} catch {
  dog = null;
}

if (!dog) {
  return Astro.redirect('/404');
}

const title = strings.dogProfile.title.replace('{name}', dog.name);
const description = strings.dogProfile.description.replace('{name}', dog.name).replace('{breed}', dog.breed);
const primaryPhoto = dog.photos.find((p) => p.isPrimary) ?? dog.photos[0];
const ogImage = primaryPhoto?.url ?? '/og-image.png';
const otherPhotos = dog.photos.filter((p) => p !== primaryPhoto);

const years = Math.floor(dog.ageMonths / 12);
const months = dog.ageMonths % 12;
const ageParts: string[] = [];
if (years > 0) ageParts.push(`${years} ${strings.dogProfile.years}`);
if (months > 0 || years === 0) ageParts.push(`${months} ${strings.dogProfile.months}`);
const ageText = ageParts.join(', ');

---

<BaseLayout title={title} description={description} ogImage={ogImage} locale={locale}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {/* Hero photo */}
    {primaryPhoto && (
      <div class="mb-8 overflow-hidden rounded-2xl">
        <img
          src={primaryPhoto.url}
          alt={dog.name}
          class="w-full max-h-[480px] object-cover"
          loading="eager"
        />
      </div>
    )}

    {/* Name + breed */}
    <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900">{dog.name}</h1>
    <p class="mt-1 text-lg text-neutral-600">
      {dog.breed}{dog.breedSecondary ? ` × ${dog.breedSecondary}` : ''}
    </p>

    {/* Tags row */}
    <div class="mt-6 flex flex-wrap gap-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.size}: {getSizeLabel(dog.size, locale)}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.energy}: {getEnergyLabel(dog.energyLevel, locale)}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.behavior}: {getBehaviorLabel(dog.behaviorWithDogs, locale)}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.gender}: {getGenderLabel(dog.gender, locale)}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.age}: {ageText}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-800">
        {strings.dogProfile.weight}: {dog.weightKg} {strings.dogProfile.kg}
      </span>
    </div>

    {/* Bio */}
    {dog.bio && (
      <div class="mt-8">
        <h2 class="text-lg font-semibold text-neutral-900 mb-2">{strings.dogProfile.bio}</h2>
        <p class="text-neutral-700 leading-relaxed">{dog.bio}</p>
      </div>
    )}

    {/* Photo gallery */}
    {otherPhotos.length > 0 && (
      <div class="mt-8">
        <h2 class="text-lg font-semibold text-neutral-900 mb-3">{strings.dogProfile.photos}</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {otherPhotos.map((photo) => (
            <div class="overflow-hidden rounded-xl">
              <img
                src={photo.url}
                alt={dog.name}
                class="w-full aspect-square object-cover"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Owner card */}
    <div class="mt-8 p-4 rounded-xl bg-neutral-50 border border-neutral-200">
      <p class="text-sm text-neutral-500">{strings.dogProfile.owner}</p>
      <p class="text-neutral-900 font-medium">{dog.ownerFirstName}</p>
    </div>

    {/* CTA */}
    <div class="mt-10 text-center p-8 rounded-2xl bg-primary-50">
      <p class="text-lg font-semibold text-primary-900 mb-4">
        {strings.dogProfile.cta.replace('{name}', dog.name)}
      </p>
      <a
        href={locale === 'it' ? '/waitlist' : `/${locale}/waitlist`}
        class="inline-flex items-center px-6 py-3 rounded-full bg-primary text-white font-medium hover:bg-primary-700 transition-colors"
      >
        {strings.dogProfile.ctaButton}
      </a>
    </div>
  </div>
</BaseLayout>
