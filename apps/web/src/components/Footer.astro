---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n';
import { getSiteLinks, getLegalLinks } from '../data/navigation';
import { getCopyrightYear } from '../utils/meta';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const strings = t(locale);
const siteLinks = getSiteLinks(locale);
const legalLinks = getLegalLinks(locale);
const currentYear = getCopyrightYear();
const homeHref = locale === 'it' ? '/' : '/en';
---

<footer class="bg-neutral-900 text-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <!-- Brand column -->
      <div class="md:col-span-5">
        <a href={homeHref} class="flex items-center gap-2.5 mb-5 group">
          <img src="/favicon.svg" alt="" class="w-9 h-9" aria-hidden="true" />
          <span class="text-[20px] font-bold text-white">PawMeet</span>
        </a>
        <p class="text-[15px] text-neutral-300 leading-relaxed max-w-sm">
          {strings.footer.tagline}
        </p>
        <div class="mt-6 flex items-center gap-1">
          <span class="inline-block w-8 h-1 rounded-full bg-primary"></span>
          <span class="inline-block w-2 h-1 rounded-full bg-secondary"></span>
        </div>
      </div>

      <!-- Site links -->
      <div class="md:col-span-3 md:col-start-7">
        <h3 class="text-[13px] font-semibold text-neutral-400 uppercase tracking-wider mb-4">{strings.footer.exploreHeading}</h3>
        <ul class="space-y-3">
          {siteLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[15px] text-neutral-300 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div class="md:col-span-3">
        <h3 class="text-[13px] font-semibold text-neutral-400 uppercase tracking-wider mb-4">{strings.footer.legalHeading}</h3>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[15px] text-neutral-300 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 pt-8 border-t border-neutral-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[13px] text-neutral-400">
        &copy; {currentYear} {strings.footer.copyright} &middot; {strings.footer.vat}
      </p>
      <a
        href="mailto:info@pawmeet.io"
        class="text-[13px] text-neutral-400 hover:text-neutral-300 transition-colors"
      >
        info@pawmeet.io
      </a>
    </div>
  </div>
</footer>
