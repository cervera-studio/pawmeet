---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<BaseLayout title="Lista d'attesa" description="Iscriviti alla lista d'attesa di PawMeet e sii tra i primi a provare l'app.">
  <div class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
        Unisciti alla lista d'attesa
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        PawMeet sta arrivando! Iscriviti per essere tra i primi a scoprire l'app e ricevere
        accesso anticipato esclusivo.
      </p>
    </div>

    <WaitlistForm />

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-primary">1.200+</div>
          <div class="text-sm text-gray-500 mt-1">Iscritti alla waitlist</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary">15+</div>
          <div class="text-sm text-gray-500 mt-1">Citta coperte</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary">2026</div>
          <div class="text-sm text-gray-500 mt-1">Lancio previsto</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
