{
  "expo": {
    "name": "PawMeet",
    "slug": "pawmeet",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "pawmeet",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.pawmeet.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": ["webcredentials:pawmeet.io"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Per mostrarti cani nelle vicinanze",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Per aggiornare la tua posizione",
        "NSCameraUsageDescription": "Per scattare foto del tuo cane",
        "NSPhotoLibraryUsageDescription": "Per caricare foto del tuo cane",
        "NSHealthShareUsageDescription": "PawMeet utilizza i dati di Apple Salute per sincronizzare passi, distanza e attività con il tuo profilo.",
        "NSFaceIDUsageDescription": "Per proteggere l'accesso alla tua app PawMeet",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#065F46"
      },
      "package": "io.pawmeet.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "organization": "cervera-studio",
          "project": "pawmeet-mobile"
        }
      ],
      "./plugins/with-certificate-pinning",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "react-native-health-connect",
        {
          "isSdkExtensionPatched": true
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "@react-native-google-signin/google-signin",
      "./plugins/with-sentry-allow-failure"
    ],
    "extra": {
      "router": {},
      "googleWebClientId": "102633148388-jt1p86oakgel11d5u3171e1iofimk7nm.apps.googleusercontent.com",
      "googleAndroidClientId": "102633148388-i3jm19so5n4cp1ssh20vsttk15h8l37k.apps.googleusercontent.com",
      "googleIosClientId": "102633148388-7o6fvbtaanqmifbq109nt59n72vfo38v.apps.googleusercontent.com",
      "eas": {
        "projectId": "979c0a63-948a-4c9c-a003-0b0f09a55bf9"
      }
    },
    "owner": "cerverastudio"
  }
}
