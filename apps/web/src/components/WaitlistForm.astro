---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n';
import WaitlistFormClient from './WaitlistFormClient';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const strings = t(locale);
---

<WaitlistFormClient client:visible strings={strings.waitlist} locale={locale} />
